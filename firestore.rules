rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() &&
        request.auth.uid == uid &&
        request.resource.data.role == 'USER' &&
        (!('walletBalance' in request.resource.data) ||
         request.resource.data.walletBalance == 0);
      allow update: if isSignedIn() &&
        request.auth.uid == uid &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'walletBalance']);
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /items/{itemId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /auction_sessions/{sessionId} {
      allow read: if true;
      allow write: if false;
    }

    match /bids/{bidId} {
      allow read: if true;
      allow write: if false;
    }

    match /bid_proxies/{proxyId} {
      allow read: if false;
      allow write: if false;
    }

    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.buyerUid == request.auth.uid ||
         resource.data.sellerUid == request.auth.uid);
      allow write: if false;
    }

    match /deposits/{depositId} {
      allow read: if isSignedIn() && resource.data.userUid == request.auth.uid;
      allow write: if false;
    }

    match /wallet_topups/{topupId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow write: if false;
    }

    match /escrow_transactions/{transactionId} {
      allow read: if isSignedIn() &&
        (resource.data.buyerUid == request.auth.uid ||
         resource.data.sellerUid == request.auth.uid);
      allow write: if false;
    }

    match /second_chance_offers/{offerId} {
      allow read: if isSignedIn() && resource.data.bidderUid == request.auth.uid;
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userUid == request.auth.uid;
      allow write: if false;
    }

  }
}